{
  "name": "mono",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,yellow \"npm:dev -w @mono/api\" \"npm:dev -w @mono/worker\" \"npm:dev -w @mono/web\"",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "postinstall": "prisma generate",
    "test:e2e:docker": "docker run --rm --network host --ipc host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work --env-file .env -e E2E_BASE_URL -e E2E_SCREENSHOTS -e E2E_AI mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "icons": "docker run --rm --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble node scripts/make-icons.mjs",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:ggm": "tsx prisma/seed-ggm.ts",
    "reset-password": "tsx --env-file-if-exists=.env prisma/reset-password.ts",
    "postdb:migrate": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
