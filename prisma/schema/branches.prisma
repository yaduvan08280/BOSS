/// Phase 12 (plan §3.1): Group (the company) → legal entity → region → branch → location.

/// One GSTIN, or one foreign registration. Own, or a franchise (hard isolation — stage D).
model LegalEntity {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  name      String
  /// OWN | FRANCHISE
  kind      String    @default("OWN")
  /// ISO country code and currency; Indian entities keep IN / INR.
  country   String    @default("IN")
  currency  String    @default("INR")
  state     String?
  /// GSTIN, or the foreign tax registration (TRN / VAT number).
  taxId     String?   @map("tax_id")
  isDefault Boolean   @default(false) @map("is_default")
  /// Letterhead, address, licences, tax profile … (stages B and C fill these).
  details   Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([companyId])
  @@map("legal_entities")
}

/// A grouping of branches inside an entity ("Rajasthan", "Dubai"), to any depth.
model Region {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  entityId  String?   @map("entity_id")
  parentId  String?   @map("parent_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([companyId])
  @@map("regions")
}

/// A stock point inside a branch (main store, cold room, kitchen, bar). Stock per location arrives in phase 13.
model Location {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  branchId  String    @map("branch_id")
  name      String
  /// STORE | KITCHEN | BAR | COLD_ROOM | OTHER
  kind      String    @default("STORE")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([companyId, branchId])
  @@map("locations")
}

/// Who runs what: a branch's managers and HR, a region's area managers. One person may hold many.
model BranchManager {
  id        String   @id @default(cuid(2))
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  /// Exactly one of the two is set.
  branchId  String?  @map("branch_id")
  regionId  String?  @map("region_id")
  /// MANAGER (a branch) | AREA (a region) | HR (a branch's HR person)
  role      String   @default("MANAGER")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, branchId, regionId, role])
  @@index([companyId, branchId])
  @@index([companyId, regionId])
  @@index([companyId, userId])
  @@map("branch_managers")
}

/// Branches a person works at besides their home branch (`User.branchId`).
model UserBranch {
  id        String   @id @default(cuid(2))
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, branchId])
  @@index([companyId, branchId])
  @@map("user_branches")
}

/// The head of a department at one branch (the Kitchen head at Outlet 3); `Department.hodUserId` stays group-wide.
/// Where a person works from a date (phase 12, stage B): a move takes effect on its day. The stay ends when the
/// next one begins. `fromBranchId` is where they were before the first recorded move.
model BranchStay {
  id           String   @id @default(cuid(2))
  companyId    String   @map("company_id")
  userId       String   @map("user_id")
  branchId     String?  @map("branch_id")
  /// YYYY-MM-DD in the company's time zone.
  from         String
  fromBranchId String?  @map("from_branch_id")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, from])
  @@index([companyId, from])
  @@map("branch_stays")
}

/// A person lent to another branch for some days (phase 12): they show on its lists and cover board, may punch
/// there, and their cost for those days goes to that branch.
model BranchLoan {
  id          String   @id @default(cuid(2))
  companyId   String   @map("company_id")
  userId      String   @map("user_id")
  branchId    String   @map("branch_id")
  /// YYYY-MM-DD, both days included.
  from        String
  to          String
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, userId])
  @@index([companyId, branchId, from])
  @@map("branch_loans")
}

/// One rate per currency per month, typed by an accountant (phase 12, decision 11): rupees for one unit of the
/// currency. Group totals are shown in INR with it.
model ExchangeRate {
  id          String   @id @default(cuid(2))
  companyId   String   @map("company_id")
  /// ISO code: AED, USD …
  currency    String
  /// YYYY-MM
  month       String
  rate        Decimal  @db.Decimal(14, 6)
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, currency, month])
  @@map("exchange_rates")
}

/// A month's royalty and fees from a franchise (stage D): % of its sales and / or a fixed fee, never under the
/// minimum guarantee. One per franchise per month; amounts in the franchise entity's currency (minor units).
model RoyaltyInvoice {
  id           String   @id @default(cuid(2))
  companyId    String   @map("company_id")
  entityId     String   @map("entity_id")
  /// YYYY-MM
  month        String
  /// ROY/26-27/0001
  number       String
  salesPaise   BigInt   @map("sales_paise")
  royaltyPaise BigInt   @map("royalty_paise")
  fixedPaise   BigInt   @map("fixed_paise")
  /// What is due: the larger of (royalty + fixed) and the minimum guarantee.
  amountPaise  BigInt   @map("amount_paise")
  minimumUsed  Boolean  @default(false) @map("minimum_used")
  /// ISSUED | PAID | CANCELLED
  status       String   @default("ISSUED")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([entityId, month])
  @@unique([companyId, number])
  @@map("royalty_invoices")
}

/// A brand audit at an outlet (stage D): a head-office auditor scores each point; failed points become tasks.
model BrandAudit {
  id        String   @id @default(cuid(2))
  companyId String   @map("company_id")
  branchId  String   @map("branch_id")
  auditorId String   @map("auditor_id")
  title     String
  /// YYYY-MM-DD
  date      String
  /// [{ text, ok, note?, photoId?, taskId? }]
  items     Json
  /// Points passed, of 100.
  score     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, branchId, date])
  @@map("brand_audits")
}

model DepartmentHead {
  id           String   @id @default(cuid(2))
  companyId    String   @map("company_id")
  departmentId String   @map("department_id")
  branchId     String   @map("branch_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([departmentId, branchId])
  @@index([companyId, branchId])
  @@map("department_heads")
}

/// Who approves, in what order (plan §3.2, decision 14: the owner decides). One row per module + request type,
/// for the whole group, or overriding it for an entity or a branch.
model ApprovalRoute {
  id          String   @id @default(cuid(2))
  companyId   String   @map("company_id")
  /// hr.leave | hr.correction | ims.adjustment | slip | ticket …
  kind        String
  /// Null + null = the group's chain; one of them set = an override there.
  entityId    String?  @map("entity_id")
  branchId    String?  @map("branch_id")
  /// ApprovalStep[] (shared zod): who, skip rules, hours before it goes up.
  steps       Json
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, kind, entityId, branchId])
  @@map("approval_routes")
}

/// One person who owns more than one company in this MONO (the owner's morning page shows them side by side).
/// The link is made once by signing in to the other company from this one — never by a matching mobile alone.
model OwnerLink {
  id             String   @id @default(cuid(2))
  companyId      String   @map("company_id")
  userId         String   @map("user_id")
  otherCompanyId String   @map("other_company_id")
  otherUserId    String   @map("other_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, otherCompanyId])
  @@index([companyId, userId])
  @@map("owner_links")
}
