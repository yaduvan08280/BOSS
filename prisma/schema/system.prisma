/// Refresh-token sessions. Only a SHA-256 hash of the token is stored; rotated on every refresh.
model Session {
  id           String    @id @default(cuid(2))
  companyId    String    @map("company_id")
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ip           String?
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// What the parts of the installation last said about themselves (the worker's heartbeat, the last backup,
/// the weekly restore test, how full the disks are): written by the worker and the backup container, read by
/// the health check. Not a company's data.
model OpsMark {
  key  String   @id
  ok   Boolean  @default(true)
  note String?
  at   DateTime @default(now()) @db.Timestamptz(3)

  @@map("ops_marks")
}

/// Failed sign-ins per login ID (a hash of it), so one account cannot be guessed at from many addresses.
/// A row lives only while there are recent failures: a good sign-in deletes it.
model LoginThrottle {
  /// sha256 of the normalised login ID (mobile in E.164 or lower-case email).
  key         String    @id
  fails       Int       @default(0)
  windowAt    DateTime  @map("window_at") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  @@map("login_throttles")
}

model AuditLog {
  id         String   @id @default(cuid(2))
  companyId  String   @map("company_id")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  /// The archive job reads the oldest rows first.
  @@index([createdAt])
  @@map("audit_logs")
}

/// Transactional outbox for domain events: written in the same transaction as the change,
/// dispatched by the worker (notification rules, webhooks, SSE fan-out).
model DomainEvent {
  id           String    @id @default(cuid(2))
  companyId    String    @map("company_id")
  name         String
  actorId      String?   @map("actor_id")
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  payload      Json      @default("{}")
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")

  @@index([dispatchedAt, occurredAt])
  @@index([companyId, name, occurredAt])
  @@map("domain_events")
}

/// In-app notification (always created, whatever other channels fire).
model Notification {
  id         String    @id @default(cuid(2))
  companyId  String    @map("company_id")
  userId     String    @map("user_id")
  title      String
  body       String?
  link       String?
  eventId    String?   @map("event_id")
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  /// Escalations, failures … shown with the warning style.
  tone       String?
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([companyId, userId, readAt])
  /// A person's notifications, newest first; and the daily clean-up by age.
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  /// "Was this event already told?" — asked for every event the worker handles.
  @@index([eventId])
  @@map("notifications")
}
