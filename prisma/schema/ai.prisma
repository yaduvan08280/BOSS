/// AI connection of a company (CLAUDE.md §13). The API key lives encrypted in `secret`.
model AiConfig {
  id            String    @id @default(cuid(2))
  companyId     String    @unique @map("company_id")
  /// anthropic | openai | gemini | ollama
  provider      String
  model         String
  /// Ollama (or an OpenAI-compatible server): where it runs
  baseUrl       String?   @map("base_url")
  /// encryptJson({ apiKey, sttKey })
  secret        String?
  /// Price per million tokens (USD) when the model is not in MONO's price list
  priceIn       Decimal?  @map("price_in") @db.Decimal(10, 4)
  priceOut      Decimal?  @map("price_out") @db.Decimal(10, 4)
  /// browser | openai | gemini | whisper — who turns speech into text
  sttProvider   String    @default("browser") @map("stt_provider")
  sttModel      String?   @map("stt_model")
  /// A Whisper-compatible server of the company's own (sttProvider = whisper)
  sttBaseUrl    String?   @map("stt_base_url")
  dailySummary  Boolean   @default(true) @map("daily_summary")
  lastTestAt    DateTime? @map("last_test_at") @db.Timestamptz(3)
  lastTestOk    Boolean?  @map("last_test_ok")
  lastTestError String?   @map("last_test_error")
  updatedById   String?   @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_configs")
}

/// One row per AI call: who, what for, tokens and the estimated cost.
model AiUsage {
  id           String   @id @default(cuid(2))
  companyId    String   @map("company_id")
  userId       String?  @map("user_id")
  /// build_flow | edit_flow | kpis | master | ask | ask_answer | business | daily_summary | follow_up | transcribe | test
  feature      String
  provider     String
  model        String
  /// prompt template id@version
  prompt       String?
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  /// estimated cost in millionths of a US dollar
  costMicros   Int      @default(0) @map("cost_micros")
  ms           Int      @default(0)
  ok           Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@map("ai_usage")
}

/// "Your business, in your words" — included in every AI prompt.
model BusinessDetails {
  id          String   @id @default(cuid(2))
  companyId   String   @unique @map("company_id")
  text        String   @default("")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_details")
}

/// A custom master (CLAUDE.md §8): its fields. Rows, import and the library arrive in phase 10.
model MasterDef {
  id           String    @id @default(cuid(2))
  companyId    String    @map("company_id")
  name         String
  /// [{ key, label, type, required, options? }] — the FMS field types
  fields       Json
  keyField     String?   @map("key_field")
  displayField String?   @map("display_field")
  /// ai | library | own
  source       String    @default("own")
  description  String?
  /// Brand content (phase 12, stage D): franchises may read its group-wide rows, never change them.
  shared       Boolean   @default(false)
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  rows MasterRow[]

  @@index([companyId, deletedAt])
  @@map("master_defs")
}

/// A row of a master (phase 10): the values by field key, its unique key (when the master has one) and the text it shows as.
model MasterRow {
  id          String    @id @default(cuid(2))
  companyId   String    @map("company_id")
  /// A row of one branch (phase 12); null = the whole group reads it.
  branchId    String?   @map("branch_id")
  masterId    String    @map("master_id")
  data        Json
  /// The key field's value (null after a delete, so the key can be used again).
  key         String?
  /// The display field's value: what pickers show and "from a master" fields keep.
  label       String
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  master MasterDef @relation(fields: [masterId], references: [id])

  @@unique([masterId, key])
  @@index([companyId, masterId, label])
  @@map("master_rows")
}

/// The AI chat (14/11/2026): a person's conversations with the assistant. The owner's chat reads everything;
/// anyone else's only what their rights and branches allow (their own rows for personal data).
model AiChat {
  id        String          @id @default(cuid(2))
  companyId String          @map("company_id")
  userId    String          @map("user_id")
  title     String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(3)
  messages  AiChatMessage[]

  @@index([companyId, userId, updatedAt])
  @@map("ai_chats")
}

/// One turn: the person's question or the assistant's answer (with the tables and steps behind it in `data`).
model AiChatMessage {
  id        String   @id @default(cuid(2))
  companyId String   @map("company_id")
  chatId    String   @map("chat_id")
  chat      AiChat   @relation(fields: [chatId], references: [id])
  /// user | assistant
  role      String
  content   String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}
