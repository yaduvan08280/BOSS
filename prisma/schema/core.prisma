enum UserStatus {
  ACTIVE
  INACTIVE
  LEFT
}

model Company {
  id           String    @id @default(cuid(2))
  /// Trading name
  name         String
  legalName    String?   @map("legal_name")
  slug         String    @unique
  city         String?
  state        String?
  ownerName    String?   @map("owner_name")
  mobile       String?
  email        String?
  website      String?
  cin          String?
  gstin        String?
  pan          String?
  timezone     String    @default("Asia/Kolkata")
  fyStartMonth Int       @default(4) @map("fy_start_month")
  /// appName, theme {seed,warmth,radius,sidebar,buttons}, logoUrl, defaultLang, defaultThemeMode …
  settings     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  branches     Branch[]
  shifts       Shift[]
  departments  Department[]
  designations Designation[]
  roles        Role[]
  users        User[]
  contacts     CompanyContact[]

  @@map("companies")
}

/// Company points of contact ("Add as many as you need").
model CompanyContact {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  role      String
  name      String
  phone     String?
  email     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("company_contacts")
}

model Branch {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  parentId  String?   @map("parent_id")
  name      String
  code      String?
  city      String?
  state     String?
  lat       Decimal?  @db.Decimal(9, 6)
  lng       Decimal?  @db.Decimal(9, 6)
  radiusM   Int?      @map("radius_m")
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id])
  parent   Branch?  @relation("BranchTree", fields: [parentId], references: [id])
  children Branch[] @relation("BranchTree")
  users    User[]

  @@index([companyId])
  @@map("branches")
}

model Shift {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  name      String
  /// Wall-clock minutes from midnight in the company time zone. end < start means overnight.
  startMin  Int       @map("start_min")
  endMin    Int       @map("end_min")
  /// 1 = Monday … 7 = Sunday
  weekdays  Int[]     @default([1, 2, 3, 4, 5, 6])
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@index([companyId])
  @@map("shifts")
}

model Department {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  parentId  String?   @map("parent_id")
  name      String
  color     String?
  hodUserId String?   @map("hod_user_id")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id])
  parent      Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[]     @relation("DepartmentTree")
  hod         User?            @relation("DepartmentHod", fields: [hodUserId], references: [id])
  mainMembers User[]           @relation("MainDepartment")
  members     UserDepartment[]

  @@index([companyId, parentId])
  @@map("departments")
}

model Designation {
  id        String    @id @default(cuid(2))
  companyId String    @map("company_id")
  name      String
  color     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@unique([companyId, name])
  @@map("designations")
}

model Role {
  id          String    @id @default(cuid(2))
  companyId   String    @map("company_id")
  name        String
  /// Built-in role key (OWNER, ADMIN, HOD, SUPERVISOR, EA, MEMBER) or null for custom roles.
  key         String?
  /// Permission keys like "delegation.view", or "*".
  permissions String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@map("roles")
}

model User {
  id                 String     @id @default(cuid(2))
  companyId          String     @map("company_id")
  /// Human code, e.g. EMP-001 (per company, from counters).
  code               String
  name               String
  /// E.164, e.g. +919829012345
  mobile             String?
  email              String?
  passwordHash       String?    @map("password_hash")
  roleId             String     @map("role_id")
  designationId      String?    @map("designation_id")
  mainDepartmentId   String?    @map("main_department_id")
  reportsToId        String?    @map("reports_to_id")
  status             UserStatus @default(ACTIVE)
  loginEnabled       Boolean    @default(false) @map("login_enabled")
  branchId           String?    @map("branch_id")
  shiftId            String?    @map("shift_id")
  defaultBuddyId     String?    @map("default_buddy_id")
  telegramChatId     String?    @map("telegram_chat_id")
  lang               String     @default("en")
  themeMode          String     @default("system") @map("theme_mode")
  /// Per-user preferences: favourite screens, density …
  prefs              Json       @default("{}")
  /// Set after an admin reset; the user must pick a new password before doing anything else.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  avatarUrl          String?    @map("avatar_url")
  /// HR-only details (DOJ, DOB, bank, PAN, Aadhaar last 4, salary …)
  hr                 Json       @default("{}")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  company        Company          @relation(fields: [companyId], references: [id])
  role           Role             @relation(fields: [roleId], references: [id])
  designation    Designation?     @relation(fields: [designationId], references: [id])
  mainDepartment Department?      @relation("MainDepartment", fields: [mainDepartmentId], references: [id])
  reportsTo      User?            @relation("ReportsTo", fields: [reportsToId], references: [id])
  reports        User[]           @relation("ReportsTo")
  defaultBuddy   User?            @relation("DefaultBuddy", fields: [defaultBuddyId], references: [id])
  buddyFor       User[]           @relation("DefaultBuddy")
  branch         Branch?          @relation(fields: [branchId], references: [id])
  shift          Shift?           @relation(fields: [shiftId], references: [id])
  hodOf          Department[]     @relation("DepartmentHod")
  departments    UserDepartment[]
  sessions       Session[]
  notifications  Notification[]

  @@unique([companyId, code])
  @@unique([companyId, mobile])
  @@unique([companyId, email])
  @@index([mobile])
  @@index([email])
  @@index([companyId, status])
  @@map("users")
}

/// "Also works in" — extra departments besides the main one.
model UserDepartment {
  companyId    String   @map("company_id")
  userId       String   @map("user_id")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId])
  @@index([companyId, departmentId])
  @@map("user_departments")
}

/// Human numbers per company per type per FY (fy = '' when the number does not restart each year).
model Counter {
  companyId String @map("company_id")
  key       String
  fy        String @default("")
  value     Int    @default(0)

  @@id([companyId, key, fy])
  @@map("counters")
}

model ModuleSetting {
  id          String   @id @default(cuid(2))
  companyId   String   @map("company_id")
  module      String
  json        Json     @default("{}")
  changedById String?  @map("changed_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, module])
  @@map("module_settings")
}

model Attachment {
  id           String    @id @default(cuid(2))
  companyId    String    @map("company_id")
  entityType   String    @map("entity_type")
  entityId     String    @map("entity_id")
  path         String
  mime         String
  size         Int
  originalName String    @map("original_name")
  driveFileId  String?   @map("drive_file_id")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}
