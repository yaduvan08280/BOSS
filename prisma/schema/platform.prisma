// Phase 10 — the public API (keys, outgoing webhooks), Google Drive, and error monitoring.

/// A key for the public API (/api/v1). Only a hash is kept; the key is shown once when made.
model ApiKey {
  id          String    @id @default(cuid(2))
  companyId   String    @map("company_id")
  name        String
  /// The first characters after "mono_", to find the key without the secret.
  prefix      String    @unique
  /// sha256 of the whole key.
  hash        String
  last4       String
  createdById String?   @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId])
  @@map("api_keys")
}

/// An outgoing webhook: these events are posted (signed) to the URL.
model Webhook {
  id          String    @id @default(cuid(2))
  companyId   String    @map("company_id")
  url         String
  events      String[]
  /// The signing secret, encrypted with APP_SECRET.
  secret      String
  active      Boolean   @default(true)
  description String?
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(cuid(2))
  companyId    String    @map("company_id")
  webhookId    String    @map("webhook_id")
  eventId      String    @map("event_id")
  event        String
  /// PENDING | SENT | FAILED
  status       String    @default("PENDING")
  tries        Int       @default(0)
  nextAt       DateTime  @default(now()) @map("next_at") @db.Timestamptz(3)
  responseCode Int?      @map("response_code")
  error        String?
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@unique([webhookId, eventId])
  @@index([status, nextAt])
  @@map("webhook_deliveries")
}

/// A company's own Google Drive (drive.file scope): the OAuth client, the refresh token and the "{APP} Files" folder.
model DriveConnection {
  id             String    @id @default(cuid(2))
  companyId      String    @unique @map("company_id")
  clientId       String    @map("client_id")
  /// The client secret and the refresh token, encrypted with APP_SECRET.
  secrets        String
  /// waiting (sent to Google) | connected | error
  status         String    @default("waiting")
  accountEmail   String?   @map("account_email")
  folderId       String?   @map("folder_id")
  /// The OAuth "state" while waiting for Google to send the person back.
  state          String?
  stateExpiresAt DateTime? @map("state_expires_at") @db.Timestamptz(3)
  lastError      String?   @map("last_error")
  connectedById  String?   @map("connected_by_id")
  connectedAt    DateTime? @map("connected_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("drive_connections")
}

/// Errors seen by the API, the worker or a browser, grouped by fingerprint (one row each, counted).
model ErrorEvent {
  id          String    @id @default(cuid(2))
  companyId   String?   @map("company_id")
  /// api | worker | web
  source      String
  fingerprint String    @unique
  message     String
  stack       String?
  path        String?
  count       Int       @default(1)
  lastUserId  String?   @map("last_user_id")
  firstAt     DateTime  @default(now()) @map("first_at") @db.Timestamptz(3)
  lastAt      DateTime  @default(now()) @map("last_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@index([lastAt])
  @@map("error_events")
}
