# ---- App ----
APP_NAME=MONO
BASE_URL=http://localhost:5173
NODE_ENV=development
TZ=UTC
# 64+ random characters: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgresql://mono:mono@localhost:5432/mono
# Used only by `npm test`
TEST_DATABASE_URL=postgresql://mono:mono@localhost:5432/mono_test

# ---- First company + owner (used by `npm run db:seed`) ----
SEED_COMPANY_NAME=GGM Minerals
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9800000000
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123

# ---- Messaging (Phase 2) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Production only (deploy/docker-compose.yml) ----
POSTGRES_PASSWORD=change-me
CLOUDFLARE_TUNNEL_TOKEN=
# Where the production stack keeps its data
DATA_DIR=/srv/mono
# Web port for local/LAN access (Cloudflare Tunnel does not need it). Use 0.0.0.0 to open it to the LAN.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Turn on the Cloudflare Tunnel container
COMPOSE_PROFILES=tunnel
# Backups (time zone for the schedule, cron, retention, optional rclone remote like gdrive:mono-backups)
BACKUP_TZ=Asia/Kolkata
BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAYS=14
RCLONE_REMOTE=
